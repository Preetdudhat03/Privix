<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- One-handed spacer (pushes content down) -->
        <View
            android:layout_width="0dp"
            android:layout_height="120dp" />

        <!-- Lock Icon -->
        <ImageView
            android:id="@+id/ivLockIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@android:drawable/ic_lock_lock"
            android:tint="#FFFFFF"
            android:contentDescription="Locked" />

        <!-- App Name -->
        <TextView
            android:id="@+id/tvLockedAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Privix Lock"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Enter your secure PIN"
            android:textColor="#8E8E93"
            android:textSize="15sp"
            android:fontFamily="sans-serif" />

        <!-- Error Text (One UI Red) -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="PIN incorrect. Please try again."
            android:textColor="#FF453A"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="invisible" />

        <!-- PIN Dots Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            android:gravity="center">

            <View android:id="@+id/pinDot1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="10dp"
                android:background="@drawable/pin_dot_selector" />

            <View android:id="@+id/pinDot2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="10dp"
                android:background="@drawable/pin_dot_selector" />

            <View android:id="@+id/pinDot3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="10dp"
                android:background="@drawable/pin_dot_selector" />

            <View android:id="@+id/pinDot4"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="10dp"
                android:background="@drawable/pin_dot_selector" />

            <View android:id="@+id/pinDot5"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="10dp"
                android:background="@drawable/pin_dot_selector"
                android:visibility="gone" />

            <View android:id="@+id/pinDot6"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="10dp"
                android:background="@drawable/pin_dot_selector"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Dynamic Spacer for Number Pad position -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Number Pad (Large Touch Targets) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Row 1: 1 2 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView android:id="@+id/btn1"
                    style="@style/PinButton"
                    android:text="1" />
                <TextView android:id="@+id/btn2"
                    style="@style/PinButton"
                    android:text="2" />
                <TextView android:id="@+id/btn3"
                    style="@style/PinButton"
                    android:text="3" />
            </LinearLayout>

            <!-- Row 2: 4 5 6 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView android:id="@+id/btn4"
                    style="@style/PinButton"
                    android:text="4" />
                <TextView android:id="@+id/btn5"
                    style="@style/PinButton"
                    android:text="5" />
                <TextView android:id="@+id/btn6"
                    style="@style/PinButton"
                    android:text="6" />
            </LinearLayout>

            <!-- Row 3: 7 8 9 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView android:id="@+id/btn7"
                    style="@style/PinButton"
                    android:text="7" />
                <TextView android:id="@+id/btn8"
                    style="@style/PinButton"
                    android:text="8" />
                <TextView android:id="@+id/btn9"
                    style="@style/PinButton"
                    android:text="9" />
            </LinearLayout>

            <!-- Row 4: [biometric] 0 [backspace] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Placeholder for biometric -->
                <View
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="10dp" />

                <TextView android:id="@+id/btn0"
                    style="@style/PinButton"
                    android:text="0" />

                <ImageButton android:id="@+id/btnBackspace"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="10dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_input_delete"
                    android:tint="#FFFFFF"
                    android:scaleType="center"
                    android:contentDescription="Backspace" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
